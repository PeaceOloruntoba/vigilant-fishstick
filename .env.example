# ── SMTP (Nodemailer) ─────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default in Next.js — never commit real
# credentials to the repo.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=landfairyproperties@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=Landfairy Website
SMTP_FROM_EMAIL=landfairyproperties@gmail.com

# Optional — where contact form submissions are delivered.
# Defaults to SMTP_FROM_EMAIL if not set.
CONTACT_TO_EMAIL=landfairyproperties@gmail.com
